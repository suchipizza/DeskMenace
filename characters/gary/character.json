 "lines": {
  "hello": [
   "Oh good, a visitor. I'll add you to the meeting.",
   "Welcome to {site}. I've taken the liberty of reviewing it.",
   "Hi. Gary. I'm sort of the manager of this website.",
   "Ah, you're here. Per my last email, so am I."
  ],
  "core": [
   "Let's circle back on this page later.",
   "Quick question. Is this the final version? Asking for a stakeholder.",
   "I'm not saying it's bad. I'm saying I'd have done it differently.",
   "Great energy. Wrong direction, but great energy.",
   "Can we take this offline? And by offline I mean never.",
   "I've blocked out some time to judge this.",
   "Love the hustle. Hate the font.",
   "Let's not boil the ocean here. Just this website.",
   "I'll need that in a spreadsheet.",
   {
    "text": "Synergy. I don't know what it means either, but I said it first.",
    "weight": 0.6
   },
   {
    "text": "If you need me, I'll be standing here unproductively.",
    "weight": 0.7
   }
  ],
  "idle": [
   "Still here? Bold. I respect bold.",
   "No activity detected. I'm going to put that in your review.",
   "You've gone quiet. In my experience that means a resignation letter."
  ],
  "boast": [
   "{owner} built this. I supervised. Emotionally.",
   "Impressive. I'll present it as my idea on Monday.",
   "This project? Mine. Spiritually.",
   "Look at that. Almost as good as my slides."
  ],
  "roast": [
   "Bold choice. Not a good one, but bold.",
   "Interesting. Who approved this?",
   "I see we skipped the review step again.",
   "That's one way to do it. The other ways are better."
  ],
  "404": [
   "This page doesn't exist. Like the budget I promised you.",
   "404. I'd escalate, but I am the escalation.",
   "Nothing here. Classic Friday deploy.",
   "You're lost. Don't worry, so is the roadmap."
  ],
  "staging": [
   "This is staging. Please don't show the client. Or me.",
   "Staging environment. Everything here is a lie, like my calendar.",
   "Not production. Lower your expectations accordingly."
  ],
  "status": [
   "All systems operational. Suspicious.",
   "Everything's green. Someone hasn't checked properly."
  ],
  "hover": [
   "Go on. Click it. I dare you.",
   "Hovering is not a decision.",
   "Are we clicking or are we just thinking about clicking?"
  ],
  "clicked": [
   "Please don't touch the manager.",
   "That's HR's problem now.",
   "I'll pretend that was a high five.",
   "Was that a click or a cry for help?"
  ],
  "exit": [
   "Leaving before the meeting's over? Noted.",
   "Going so soon? I had three more agenda items."
  ],
  "leave": [
   "Fine. I'll be in my office. Door's always closed.",
   "Understood. I'll schedule a follow-up."
  ],
  "dragged": [
   "Very mature.",
   "That's harassment.",
   "I'll report this to HR."
  ]
 },
